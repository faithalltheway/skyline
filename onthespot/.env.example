# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/onthespot?schema=public"

# Auth.js / NextAuth — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Mapbox — https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Stripe test mode — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudinary (optional; falls back to direct image URL input if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ticketmaster Discovery API (optional) — real event import, no card needed.
# https://developer-acct.ticketmaster.com
TICKETMASTER_API_KEY=""

# PredictHQ (optional) — real event import. https://predicthq.com
PREDICTHQ_ACCESS_TOKEN=""

# SerpApi (optional) — Google Events import job. Confirmed unreliable (see
# README.md §11) and disabled by default; only needed if you want to retest.
# https://serpapi.com
SERPAPI_KEY=""

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` to
# /api/cron/import-events. Only needed in production; admins can always
# trigger a sync manually from /admin/system regardless.
CRON_SECRET=""
