// OnTheSpot — accessibility-first event discovery platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  PARTNER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OrgVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OrgMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  CANCELLED
}

enum IndoorOutdoor {
  INDOOR
  OUTDOOR
  BOTH
}

enum AccessibilityState {
  CONFIRMED
  NOT_AVAILABLE
  UNKNOWN
}

// Every structured accessibility data point tracked across the platform.
enum AccessibilityFeature {
  // Mobility
  WHEELCHAIR_ACCESSIBLE
  POWER_WHEELCHAIR_ACCESSIBLE
  STEP_FREE_ENTRANCE
  ELEVATOR_AVAILABLE
  ACCESSIBLE_PARKING
  ACCESSIBLE_RESTROOM
  ACCESSIBLE_SEATING
  COMPANION_SEATING
  WIDE_DOORWAYS
  SMOOTH_PATHWAYS
  // Sensory
  SENSORY_FRIENDLY
  LOW_NOISE_ENVIRONMENT
  QUIET_ROOM
  LOW_LIGHTING_AVAILABLE
  REDUCED_FLASHING_LIGHTS
  CROWD_LEVEL_INFO
  // Hearing
  ASL_INTERPRETATION
  ASSISTIVE_LISTENING_DEVICES
  CAPTIONS
  WRITTEN_COMMUNICATION_AVAILABLE
  // Vision
  AUDIO_DESCRIPTION
  BRAILLE_SIGNAGE
  LARGE_PRINT_MATERIALS
  SCREEN_READER_FRIENDLY_INFO
  // Additional
  SERVICE_ANIMALS_ALLOWED
  CAREGIVER_FRIENDLY
  ACCESSIBLE_TRANSPORTATION_NEARBY
  ACCESSIBLE_DROPOFF_AREA
}

enum Interest {
  MUSIC
  SPORTS
  FOOD
  ARTS
  COMMUNITY
  GAMING
  OUTDOORS
  EDUCATION
  NIGHTLIFE
  FAMILY
  OTHER
}

enum RSVPStatus {
  GOING
  INTERESTED
  CANCELLED
}

enum ReportReason {
  INCORRECT_ACCESSIBILITY
  INAPPROPRIATE
  SCAM
  WRONG_LOCATION
  DUPLICATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  APPROVE_EVENT
  REJECT_EVENT
  REQUEST_CHANGES
  SUSPEND_USER
  BAN_USER
  RESTORE_USER
  VERIFY_ORGANIZATION
  REJECT_ORGANIZATION_VERIFICATION
  SUSPEND_ORGANIZATION
  RESTORE_ORGANIZATION
  RESOLVE_REPORT
  DISMISS_REPORT
}

enum SubscriptionTier {
  FREE
  USER_PREMIUM
  PARTNER_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role          @default(USER)
  status        AccountStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  profile                  UserProfile?
  accessibilityPreferences AccessibilityPreference[]
  organizationMemberships  OrganizationMember[]
  createdEvents            Event[]                    @relation("EventCreatedBy")
  rsvps                    RSVP[]
  savedEvents              SavedEvent[]
  followingOrgs            Follow[]                   @relation("UserFollows")
  reportsFiled             Report[]                   @relation("ReportsFiled")
  reportsResolved          Report[]                   @relation("ReportsResolved")
  moderationActions        ModerationAction[]         @relation("ModerationActor")
  auditLogs                AuditLog[]                 @relation("AuditActor")
  subscription             Subscription?
  payments                 Payment[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]

  @@index([role])
  @@index([status])
}

model UserProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String     @unique
  bio         String?
  avatarUrl   String?
  city        String?
  state       String?
  zip         String?
  latitude    Float?
  longitude   Float?
  interests   Interest[] @default([])
  onboardedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AccessibilityPreference {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   AccessibilityFeature
  createdAt DateTime             @default(now())

  @@unique([userId, feature])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Organizations (Partners)
// ---------------------------------------------------------------------------

model Organization {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  description        String?
  website            String?
  logoUrl            String?
  contactEmail       String
  contactPhone       String?
  addressLine1       String?
  city               String?
  state              String?
  zip                String?
  latitude           Float?
  longitude          Float?
  socialLinks        Json?
  verificationStatus OrgVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  members            OrganizationMember[]
  events             Event[]
  verification       OrganizationVerification?
  subscription       Subscription?
  followers          Follow[]              @relation("OrgFollows")
  featuredPlacements FeaturedPlacement[]
  payments           Payment[]

  @@index([verificationStatus])
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgMemberRole @default(OWNER)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, userId])
}

model OrganizationVerification {
  id             String                @id @default(cuid())
  organizationId String                @unique
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName      String
  taxId          String?
  documentUrl    String?
  notes          String?
  status         OrgVerificationStatus @default(PENDING)
  submittedAt    DateTime              @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  icon      String?
  createdAt DateTime        @default(now())
  events    EventCategory[]
}

model Event {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  status          EventStatus @default(DRAFT)
  rejectionReason String?

  startAt        DateTime
  endAt          DateTime
  isRecurring    Boolean  @default(false)
  recurrenceRule String?

  venueName     String
  addressLine1  String
  city          String
  state         String
  zip           String
  latitude      Float
  longitude     Float
  indoorOutdoor IndoorOutdoor @default(INDOOR)

  isFree    Boolean  @default(true)
  price     Decimal? @db.Decimal(10, 2)
  ticketUrl String?
  minAge    Int?
  maxAge    Int?

  accessibilityContactName    String?
  accessibilityContactEmail   String?
  accessibilityContactPhone   String?
  accessibilityLastVerifiedAt DateTime?

  coverImageUrl String?

  viewCount     Int       @default(0)
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categories         EventCategory[]
  accessibility       EventAccessibility[]
  images              EventImage[]
  rsvps               RSVP[]
  savedBy             SavedEvent[]
  reports             Report[]
  analytics           EventAnalytics[]
  featuredPlacements  FeaturedPlacement[]

  @@index([status])
  @@index([startAt])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([organizationId])
}

model EventCategory {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId])
}

model EventAccessibility {
  id        String               @id @default(cuid())
  eventId   String
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feature   AccessibilityFeature
  state     AccessibilityState   @default(UNKNOWN)
  note      String?
  updatedAt DateTime             @updatedAt

  @@unique([eventId, feature])
}

model EventImage {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url      String
  altText  String?
  position Int     @default(0)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model RSVP {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RSVPStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
}

model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model Follow {
  id             String       @id @default(cuid())
  followerId     String
  follower       User         @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("OrgFollows", fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([followerId, organizationId])
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  reporter        User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reason          ReportReason
  details         String?
  status          ReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?        @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([eventId])
}

model ModerationAction {
  id         String               @id @default(cuid())
  actorId    String
  actor      User                 @relation("ModerationActor", fields: [actorId], references: [id])
  actionType ModerationActionType
  targetType String
  targetId   String
  reason     String
  notes      String?
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Monetization
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  userId               String?            @unique
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String?            @unique
  organization         Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id])
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  description           String?
  createdAt             DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
}

model FeaturedPlacement {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  amountCents    Int
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  @@index([eventId])
}

model EventAnalytics {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  rsvps          Int      @default(0)
  saves          Int      @default(0)
  profileViews   Int      @default(0)

  @@unique([eventId, date])
  @@index([date])
}

// Platform-configurable pricing / feature flags, editable from /admin/system.
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
